def save_profile(name, age, city):
    profile = {
    "name": name,
    "age": age,
    "city": city
}
    with open("profile.json","w",encoding="utf-8") as file:
        json.dump(profile,file,indent=4)
with open('profile.json', 'r') as file:
    print(json.load(file))

